            if mgr_name in manager_map and comp_name in company_map:
                try:
                    cursor.execute("""
                        INSERT OR IGNORE INTO ownership (manager_id, company_id, shares, value)
                        VALUES (?, ?, ?, ?)
                    """, (manager_map[mgr_name], company_map[comp_name], shares, value))
